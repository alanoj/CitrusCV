\ProvidesPackage{fontSettings}[2025/04/12 Font Settings for Resume]
\RequirePackage{lmodern}
\RequirePackage{fontspec}
\usepackage{xstring}
\usepackage[style=solid]{fontawesome7}

% Define a single Open Sans family with several weight faces.
% Assumes the .ttf files live in assets/fonts/Open_Sans/ relative to the main .tex file.
\newfontfamily\resumeFont[
    Path      = assets/fonts/Open_Sans/, % MUST end with a slash
    Extension = .ttf,                    % file extension
    UprightFont = OpenSans-Regular,      % default face
    BoldFont    = OpenSans-Bold,         % face used by \bfseries
    FontFace    = {n}{n}{OpenSans-Regular},   % 
    FontFace    = {me}{n}{OpenSans-Medium},   % medium weight; select with \fontseries{m}
    FontFace    = {mi}{n}{OpenSans-MediumItalic},   % medium weight; select with \fontseries{m}
    FontFace    = {sb}{n}{OpenSans-SemiBold} % semibold weight; select with \fontseries{sb}
]{OpenSans-Regular}
% Defines font family for Open Sans Condensed
\newfontfamily\resumeCondensedFont[
    Path      = assets/fonts/Open_Sans_Condensed/, % MUST end with a slash
    Extension = .ttf,                    % file extension
    UprightFont = OpenSans_Condensed-Regular,      % default face
    BoldFont    = OpenSans_Condensed-Bold,         % face used by \bfseries
    FontFace    = {cn}{n}{OpenSans_Condensed-Regular},   % 
    FontFace    = {cme}{n}{OpenSans_Condensed-Medium},   % medium weight; select with \fontseries{cm}
    FontFace    = {csb}{n}{OpenSans_Condensed-SemiBold} % semibold weight; select with \fontseries{csb}
]{OpenSans-Regular}

% Convenience macros for each font and weight
\newcommand{\resumeFontRegular}{\resumeFont\fontseries{n}\selectfont}
\newcommand{\resumeFontMedium}{\resumeFont\fontseries{me}\selectfont}
\newcommand{\resumeFontSemiBold}{\resumeFont\fontseries{sb}\selectfont}
\newcommand{\resumeFontBold}{\resumeFont\bfseries}
\newcommand{\textsbseries}[1]{{\resumeFontSemiBold\selectfont #1}}
\newcommand{\textbseries}[1]{{\resumeFontBold\selectfont #1}}
% Condensed font commands
\newcommand{\resumeCondensedFontRegular}{\resumeCondensedFont}
\newcommand{\resumeCondensedFontMedium}{\resumeCondensedFont\fontseries{cme}\selectfont}
\newcommand{\resumeCondensedFontSemiBold}{\resumeCondensedFont\fontseries{csb}\selectfont}


% ------------------------------ Header font Options ------------------------

\newcommand{\headerSummary}[1]{\fontsize{8.5pt}{8pt}\selectfont\resumeFontRegular\addfontfeatures{LetterSpace=1.0} #1}

% Header Full Name Font Options
\newcommand{\headerFullName}[1]{\fontsize{35pt}{30pt}\selectfont\resumeCondensedFontRegular\addfontfeature{LetterSpace=20.0} #1}

% Header Contact Into Font Options
\newcommand{\headerContactInfo}[1]{\fontsize{8pt}{9pt}\selectfont\resumeFontRegular #1}

% Header Position Title Font Options
\newcommand{\headerPosTitle}[1]{\fontsize{9pt}{9pt}\selectfont\resumeFontSemiBold\addfontfeature{LetterSpace=10.0} #1}

% Base Text Font Options
\newcommand{\baseText}[1]{\fontsize{8pt}{10pt}\selectfont\resumeFontRegular #1}

% ------------------------------ Section Title Font Options --------------------
% Use titlesec to draw a colored rule under section titles and provide a small
% wrapper so existing calls to \sectionTitle{...} continue to work.
% NOTE: this uses the color name `sectionTitleBg` which should be defined by the
% document class (or earlier in the preamble). If you prefer, adjust the color
% name or define a fallback in the class.
\AtBeginDocument{%
    % Global section style: colored rule under the title (Option A)
    \titleformat{\section}[block]
    {\normalfont}   % title text styling
    {}                                    % no label
    {0pt}                                 % separation
    {
        \color{sectionTitleBg}\rule{\linewidth}{0.9pt}\vspace{0.5ex} % top rule
        \color{black}\centering\fontsize{9pt}{8pt}\selectfont\resumeFontBold\addfontfeature{LetterSpace=10.0}}   % before-code: 
    [\vspace{-2ex}\color{sectionTitleBg}\rule{\linewidth}{0.9pt}\vspace{0.5ex}] % after-code: colored rule

    % Tighter spacing to conserve vertical space on the resume
    \titlespacing*{\section}{0pt}{4pt}{2pt}
}% end \AtBeginDocument

% Keep a lightweight wrapper so existing usages of \sectionTitle{...} keep working
\newcommand{\sectionTitle}[1]{\vspace{-4ex}\section*{#1}}

% ------------------------------ Experience Item Font Options ---------------

% Experience Company Name Font Options
\newcommand{\experienceCompanyName}[1]{\fontsize{10pt}{10pt}\selectfont\resumeFontMedium\addfontfeature{LetterSpace=2.0} #1}

% Experience Location Font Options
\newcommand{\experienceLocation}[1]{\fontsize{8pt}{9pt}\selectfont\resumeFontSemiBold\addfontfeature{LetterSpace=2.0} #1}

% Experience Position Font Options
\newcommand{\experiencePosition}[1]{\fontsize{8pt}{9pt}\selectfont\resumeFontSemiBold\addfontfeature{LetterSpace=2.0} #1}

% Experience Dates Font Options 
\newcommand{\experienceDates}[1]{\fontsize{7.5pt}{9pt}\selectfont\resumeFontSemiBold\addfontfeature{LetterSpace=2.0} \textit{#1}}

% Education School Item Font Options
\newcommand{\schoolName}[1]{\fontsize{8.5pt}{9pt}\selectfont\resumeFontBold\addfontfeature{LetterSpace=2.0} #1}

% School Location
\newcommand{\schoolLocation}[1]{\fontsize{8pt}{9pt}\selectfont\resumeFontSemiBold\addfontfeature{LetterSpace=2.0} #1}

% Degree
\newcommand{\schoolDegree}[1]{\fontsize{8pt}{9pt}\selectfont\resumeFontSemiBold\addfontfeature{LetterSpace=2.0} #1}

% Field of Study
\newcommand{\schoolField}[1]{\fontsize{8pt}{9pt}\selectfont\resumeFontMedium\addfontfeature{LetterSpace=2.0} #1}


%  Apple Logo Command
\newcommand{\applelogo}{{\fontspec{Helvetica Neue}\char"F8FF}\,\hspace{2pt}}

% Macro to color the literal input "Google"
\newcommand{\colorgoogle}[1]{%
    \IfEqCase{#1}{%
        {Google}{%
                {\textcolor{gBlue}{G}%
                        \textcolor{gRed}{o}%
                        \textcolor{gYellow}{o}%
                        \textcolor{gBlue}{g}%
                        \textcolor{gGreen}{l}%
                        \textcolor{gRed}{e}}%
            }%
    }[\PackageError{colorgoogle}{Unsupported text `#1`}{Only supports Google}]%
}

% ------------------------------ Skills Font Options ---------------

\newcommand{\technicalSkillsList}[2]{
    \fontsize{8pt}{9pt}\selectfont\resumeFontSemiBold\addfontfeature{LetterSpace=2.0} \textcolor{orange}{#1}
    \fontsize{8pt}{9pt}\selectfont\resumeFontRegular #2
}

\endinput
